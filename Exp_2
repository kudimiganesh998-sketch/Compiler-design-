#include <stdio.h>
#include <string.h>

int main() {
    char str[500];

    printf("Enter a line: ");
    fgets(str, sizeof(str), stdin);

    if (strstr(str, "//") == str) {
        printf("Single line comment\n");
    }
    else if (strstr(str, "/*") != NULL &&
             strstr(str, "*/") != NULL) {
        printf("Multi-line comment\n");
    }
    else {
        printf("Not a comment\n");
    }

    return 0;
}
