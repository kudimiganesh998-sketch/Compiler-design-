#include <stdio.h>
#include <string.h>

char input[100];
int pos = 0;

int E(), T(), F();

int E() {
    if (!T())
        return 0;

    if (input[pos] == '+') {
        pos++;
        return E();
    }

    return 1;
}

int T() {
    if (!F())
        return 0;

    if (input[pos] == '*') {
        pos++;
        return T();
    }

    return 1;
}

int F() {
    if (input[pos] == 'i' && input[pos + 1] == 'd') {
        pos += 2;
        return 1;
    }

    if (input[pos] == '(') {
        pos++;

        if (E() && input[pos] == ')') {
            pos++;
            return 1;
        }
    }

    return 0;
}

int main() {
    printf("Enter string: ");
    scanf("%s", input);

    if (E() && input[pos] == '\0')
        printf("Accepted\n");
    else
        printf("Rejected\n");

    return 0;
}
