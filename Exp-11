#include <stdio.h>
#include <string.h>

struct Symbol {
    char name[30];
    char type[20];
};

struct Symbol table[100];
int n = 0;

void insert() {
    printf("Enter name: ");
    scanf("%s", table[n].name);

    printf("Enter type: ");
    scanf("%s", table[n].type);

    n++;
}

void display() {
    int i;

    printf("\nSymbol Table\n");
    printf("Name\tType\n");

    for (i = 0; i < n; i++)
        printf("%s\t%s\n", table[i].name, table[i].type);
}

void search() {
    char name[30];
    int i;

    printf("Enter symbol to search: ");
    scanf("%s", name);

    for (i = 0; i < n; i++) {
        if (strcmp(table[i].name, name) == 0) {
            printf("Found: %s - %s\n",
                   table[i].name, table[i].type);
            return;
        }
    }

    printf("Symbol not found\n");
}

int main() {
    int choice;

    do {
        printf("\n1.Insert\n2.Search\n3.Display\n4.Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1: insert(); break;
            case 2: search(); break;
            case 3: display(); break;
        }
    } while (choice != 4);

    return 0;
}
