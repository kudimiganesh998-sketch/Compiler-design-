#include <stdio.h>
#include <ctype.h>

char stack[100];
int top = -1;
int temp = 1;

void push(char c) {
    stack[++top] = c;
}

char pop() {
    return stack[top--];
}

int precedence(char c) {
    if (c == '*' || c == '/')
        return 2;
    if (c == '+' || c == '-')
        return 1;
    return 0;
}

int main() {
    char exp[100];
    char op1, op2, op;
    int i;

    printf("Enter expression: ");
    scanf("%s", exp);

    for (i = 0; exp[i] != '\0'; i++) {
        if (isalnum(exp[i])) {
            push(exp[i]);
        }
        else if (exp[i] == '*' || exp[i] == '/' ||
                 exp[i] == '+' || exp[i] == '-') {

            op = exp[i];

            op2 = pop();
            op1 = pop();

            printf("t%d = %c %c %c\n",
                   temp, op1, op, op2);

            push('0' + temp);
            temp++;
        }
    }

    printf("Result = t%d\n", temp - 1);

    return 0;
}
