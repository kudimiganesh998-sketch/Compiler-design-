#include <stdio.h>

int main() {
    int n, i;
    char result[10], op1[10], op2[10], op;

    printf("Enter number of TAC instructions: ");
    scanf("%d", &n);

    printf("Enter TAC:\n");

    for (i = 0; i < n; i++) {
        scanf("%s = %s %c %s",
              result, op1, &op, op2);

        printf("\nMOV R0, %s", op1);

        switch (op) {
            case '+':
                printf("\nADD R0, %s", op2);
                break;

            case '-':
                printf("\nSUB R0, %s", op2);
                break;

            case '*':
                printf("\nMUL R0, %s", op2);
                break;

            case '/':
                printf("\nDIV R0, %s", op2);
                break;
        }

        printf("\nMOV %s, R0\n", result);
    }

    return 0;
}
